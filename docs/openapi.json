{
  "openapi": "3.1.0",
  "info": {
    "title": "Genie Sim team collection interface",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenapi",
        "responses": {
          "200": {
            "description": "Interface document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "listCapabilities",
        "responses": {
          "200": {
            "description": "Registered and reserved operations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "operationId": "submitCollection",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollectionRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably queued or matched an existing idempotent request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, unsupported capability, conflict or missing resource.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Persistent request and available result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, unsupported capability, conflict or missing resource.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/extensions/{operation}": {
      "post": {
        "operationId": "submitExtension",
        "description": "Each operation declares its required string fields through the capabilities endpoint.",
        "parameters": [
          {
            "name": "operation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably queued or matched an existing idempotent request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Invalid request, unsupported capability, conflict or missing resource.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CollectionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction"
        ],
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "simulator": {
            "type": "string",
            "default": "isaac_physx"
          },
          "robot_id": {
            "type": "string",
            "minLength": 1
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execute": {
            "type": "boolean",
            "default": false,
            "description": "Prepare real plans by default. Set true to also run the native collection worker."
          }
        }
      },
      "Accepted": {
        "type": "object",
        "required": [
          "id",
          "status_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "status_url": {
            "type": "string"
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "state",
          "native_job_id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "finished",
              "failed",
              "interrupted"
            ]
          },
          "native_job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_unix": {
            "type": "number"
          },
          "updated_unix": {
            "type": "number"
          },
          "native": {
            "type": [
              "object",
              "null"
            ],
            "description": "Latest native job summary, when readable."
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "description": "Read result.status and its dataset receipt to distinguish preparation, review and verified completion."
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "version",
          "operations"
        ],
        "properties": {
          "version": {
            "const": "v1"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type",
                "status",
                "upstream",
                "required_inputs",
                "required_outputs"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "collection",
                    "extension"
                  ]
                },
                "status": {
                  "enum": [
                    "connected",
                    "reserved"
                  ]
                },
                "upstream": {
                  "type": "string",
                  "minLength": 1
                },
                "required_inputs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required_outputs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "robot_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "task_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "scenes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
